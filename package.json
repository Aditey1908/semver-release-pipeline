{
  "name": "semver-release-pipeline",
  "version": "0.0.0-development",
  "private": true,
  "description": "Automated release management pipeline with semantic versioning and Git tags",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "npm run build && node --watch src/index.js",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.js",
    "release:preview": "node scripts/next-version.js",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "vitest": "^5.0.3"
  }
}
