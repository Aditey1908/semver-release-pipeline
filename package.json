{
  "name": "semver-release-pipeline",
  "version": "1.1.1",
  "private": true,
  "description": "Automated release management pipeline with semantic versioning and Git tags",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "npm run build && node --watch src/index.js",
    "dev:web": "vite",
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "smoke": "node scripts/smoke-test.js",
    "release:preview": "node scripts/next-version.js",
    "release:dry-run": "semantic-release --dry-run --no-ci",
    "prepare": "husky"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semantic-release": "^25.0.9",
    "supertest": "^7.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
